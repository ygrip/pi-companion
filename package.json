{
  "name": "@yunazgr/pi-companion",
  "version": "0.3.5",
  "description": "Local-first remote control for Pi sessions: live activity feed, steering, git diff, file drop and phone pairing from a single Rust daemon.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "remote-control",
    "remote-agent",
    "companion",
    "session-dashboard",
    "developer-tools",
    "mobile"
  ],
  "homepage": "https://github.com/ygrip/pi-companion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygrip/pi-companion.git"
  },
  "bugs": {
    "url": "https://github.com/ygrip/pi-companion/issues"
  },
  "author": "ygrip <yunaz.gilang@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "skills",
    "docs/automations.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "serve": "npm run --silent ui:build -- --logLevel warn && cargo run -q --manifest-path server/Cargo.toml",
    "automation:mcp": "node --experimental-strip-types --no-warnings src/automation-mcp.ts",
    "server:dev": "npm run serve",
    "server:check": "npm run ui:build && cargo check --manifest-path server/Cargo.toml",
    "ui:dev": "cd ui && vite dev",
    "ui:build": "cd ui && vite build",
    "check": "tsc --noEmit && npm run ui:check",
    "ui:check": "cd ui && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run test:extension && npm run test:server",
    "test:extension": "node --test --experimental-transform-types --no-warnings test/*.test.ts ui/automation.test.ts",
    "test:server": "cargo test --manifest-path server/Cargo.toml",
    "test:smoke": "npm run ui:build && cargo build --manifest-path server/Cargo.toml --locked && node tools/smoke-automations.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/ygrip/pi-companion/main/docs/dashboard.png"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24.7.0",
    "@types/ws": "^8.18.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "marked": "^18.1.0",
    "mermaid": "^10.9.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typebox": "^1.0.13",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "overrides": {
    "node-domexception": "file:./tools/shims/node-domexception",
    "mermaid": {
      "katex": "^0.18.2"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "@google/genai": false,
    "protobufjs": false,
    "fsevents": false
  },
  "publishConfig": {
    "access": "public"
  }
}
