{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    // Mirrors the `imports` map in package.json for the type checker.
    "paths": {
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"],
      "$app/types": ["./.svelte-kit/types/index.d.ts"]
    }
  }
}
